{
  "name": "@hearth/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Hearth server: Fastify and ws, one image with api, realtime and worker roles. Node runs its .ts source as it is (T2).",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file=../../.env.example --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node src/main.ts",
    "db:types": "node scripts/db-types.ts && biome format --write src/db/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@hearth/access": "0.0.0",
    "@hearth/shared": "0.0.0",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2"
  }
}

{
  "name": "hearth",
  "private": true,
  "type": "module",
  "description": "Hearth, an internal work suite (docs/PRD.md). npm workspaces: apps/*, packages/*, infra and the reference demo.",
  "engines": {
    "node": ">=24.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra",
    "demo"
  ],
  "scripts": {
    "dev": "npm run dev -w @hearth/server",
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces",
    "lint": "biome check",
    "fix": "biome check --write",
    "test": "vitest run && npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}

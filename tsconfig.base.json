{
  // Every package's tsconfig extends this one (T1, T2): strict, with index access checked.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Only syntax Node 24's type stripping can remove (no enums, namespaces or parameter
    // properties). Decorators and `accessor` fields pass this check but Node can't run them, so
    // scripts/guards/server-runtime.test.ts refuses them where the server loads code (T2).
    "erasableSyntaxOnly": true,
    // The server runs its .ts source on Node (T2), so its relative imports name the .ts file.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  }
}

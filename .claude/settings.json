{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-push.sh",
            "timeout": 120,
            "statusMessage": "Committing and pushing to GitHub..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-kit": {
      "source": {
        "source": "github",
        "repo": "JohnnyVizz/claude-kit"
      }
    }
  },
  "enabledPlugins": {
    "savvy-flow@claude-kit": true,
    "savvy-progress@claude-kit": true
  }
}

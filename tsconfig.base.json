{
  // Every package's tsconfig extends this one (T1, T2): strict, with index access checked.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Only syntax Node 24's type stripping can remove (no enums, namespaces or parameter
    // properties). Imports are another matter: Node needs `./x.ts` and can't resolve `@/*`, so how
    // the server runs is decided in C0.2 (docs/TECH-SPEC.md, T2).
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  }
}

{
  // The browser code in src/ (T21). Its lib is ES2023, not the base's ES2024, so tsc refuses what
  // the pilot's oldest browser, Safari on iOS 16.4, lacks (Promise.withResolvers, Object.groupBy).
  // The Node side (vite.config.ts, the Playwright config and e2e/) is checked by tsconfig.node.json;
  // the workspace's typecheck runs both, and no file is in both.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
